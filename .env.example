# PostgreSQL / Neon application connection. Set this to persist application data.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Direct, non-pooled connection for migrations; may match DATABASE_URL locally.
# DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/database?sslmode=require

# Required in production. Generate at least 32 random bytes; keep stable across workers.
# SESSION_SECRET=
# Required in production: exact public HTTPS origin, without trailing slash or path.
# APP_ORIGIN=https://booking.example.com

PORT=5000
# Trusted reverse proxy hop count: defaults to 0 in development, 1 in production.
# TRUST_PROXY=1

# Email: Resend API key and a sender on your verified domain.
# RESEND_API_KEY=
# EMAIL_FROM=BookingPro <bookings@your-domain>
# Protected message retry/reminder job. Use 32 random bytes.
# CRON_SECRET=

# One authorized merchant/provider mapping; other providers cannot collect into it.
# PAYCHANGU_SECRET_KEY=
# PAYCHANGU_WEBHOOK_SECRET=
# PAYCHANGU_PROVIDER_ID=
# PAYCHANGU_MODE=test

# Offline backup only. Keep this key outside the database and outside Git.
# BACKUP_ENCRYPTION_KEY=
# RESTORE_DATABASE_URL=
# RESTORE_TARGET_CONFIRM=
