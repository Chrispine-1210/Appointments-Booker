# Public development pages run without authentication or a database.
PORT=5000
# Authenticated development requires a real Replit OIDC application.
# REPL_ID=
# REPLIT_DOMAINS=your-app.replit.app
# SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
# ISSUER_URL=https://replit.com/oidc
# DATABASE_URL=postgresql://...
# Production startup is intentionally blocked until MemoryStorage is replaced.
# Setting DATABASE_URL alone does not make application data persistent.
