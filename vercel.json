{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "dist/serverless.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/jobs/messages",
      "schedule": "0 5 * * *"
    }
  ]
}
